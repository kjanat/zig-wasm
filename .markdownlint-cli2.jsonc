{
	"$schema": "https://cdn.jsdelivr.net/gh/DavidAnson/markdownlint-cli2/schema/markdownlint-cli2-config-schema.json",
	"gitignore": true,
	"showFound": true,
	"config": {
		"line-length": {
			"tables": false,
			"code_blocks": false
		},
		"no-emphasis-as-heading": false,
		"no-multiple-top-level-headings": false,
		"no-inline-html": {
			"allowed_elements": ["details", "summary", "br"]
		}
	},
	"fix": false,
	// "noBanner": true,
	"globs": ["**/*.md", "!**/node_modules/**"],
	"ignores": ["CLAUDE.md"],
	"markdownItPlugins": []
}
