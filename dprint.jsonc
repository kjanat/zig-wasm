{
	"useTabs": true,
	"lineWidth": 80,
	"biome": {
		"indentStyle": "tab",
		"lineWidth": 80,
		"javascript.quoteStyle": "single"
	},
	"typescript": {},
	"json": {
		"trailingCommas": "maintain",
		"jsonTrailingCommaFiles": [
			"**/tsconfig.json",
			"**/tsconfig.*.json",
			"**/.zed/settings.json"
		]
	},
	"markdown": {
		"emphasisKind": "asterisks",
		"textWrap": "always",
		"locked": true
	},
	"toml": {},
	"dockerfile": {},
	"malva": {},
	"markup": {},
	"yaml": {},
	// "zig": {},
	"ruff": { "preview": true },
	"exec": {
		"cwd": "${originConfigDir}",
		"commands": [
			{
				"command": "pnpm dlx sort-package-json --stdin",
				"fileNames": ["package.json", "jsr.json"]
			},
			{
				"command": "zig fmt --color off --stdin",
				"exts": ["zig"]
			},
			{
				"command": "zig fmt --zon --color off --stdin",
				"exts": ["zon"]
			}
		]
	},
	"excludes": [
		"**/.zig-cache",
		"**/coverage",
		"**/dist",
		"**/node_modules",
		"**/pnpm-lock.yaml",
		"**/zig-out",
		"**/fixtures"
	],
	"plugins": [
		"https://plugins.dprint.dev/biome-0.11.11.wasm",
		"https://plugins.dprint.dev/dockerfile-0.3.3.wasm",
		"https://plugins.dprint.dev/exec-0.6.0.json@a054130d458f124f9b5c91484833828950723a5af3f8ff2bd1523bd47b83b364",
		"https://plugins.dprint.dev/g-plane/malva-v0.15.2.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.25.3.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
		"https://plugins.dprint.dev/json-0.21.1.wasm",
		"https://plugins.dprint.dev/markdown-0.20.0.wasm",
		"https://plugins.dprint.dev/ruff-0.6.14.wasm",
		"https://plugins.dprint.dev/toml-0.7.0.wasm",
		"https://plugins.dprint.dev/typescript-0.95.13.wasm"
		// "https://plugins.dprint.dev/kjanat/zig-0.2.1.wasm"
	]
}
