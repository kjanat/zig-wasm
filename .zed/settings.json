{
	"auto_install_extensions": {
		"biome": true,
		"dprint": false,
		"ruff": true,
		"tsgo": true,
		"ty": true,
		"zig": true
	},
	"formatter": {
		"external": {
			"command": "node_modules/.bin/dprint",
			"arguments": [
				"fmt",
				"--config",
				"dprint.jsonc",
				"--stdin",
				"{buffer_path}"
			]
		}
	},
	"languages": {
		"TypeScript": {
			"language_servers": ["biome", "vtsls", "!deno", "!oxc"],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": false
			}
		},
		"TSX": {
			"language_servers": ["biome", "vtsls", "!deno", "!oxc"],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": false
			}
		},
		"JavaScript": {
			"language_servers": ["biome", "vtsls", "!deno", "!oxc"],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": false
			}
		},
		"Zig": {
			"formatter": "external",
			"format_on_save": "on",
			"tab_size": 4,
			"hard_tabs": false
		}
	},
	"lsp": {
		"biome": {
			"binary": {
				"path": "./node_modules/.bin/biome",
				"arguments": ["lsp-proxy"]
			},
			"settings": {
				"require_config_file": true
			},
			"enable_lsp_tasks": true,
			"initialization_options": {
				"assist": {
					"organizeImports": {
						"enable": false
					}
				}
			}
		},
		"zls": {
			"binary": {
				"path": "zls",
				"arguments": ["--enable-build-on-save"]
			},
			"initialization_options": {
				"enable_build_on_save": true,
				"build_on_save_step": "check"
			}
		},
		"json-language-server": {
			"settings": {
				"json": {
					"schemas": [
						{
							"fileMatch": ["jsr.json"],
							"url": "https://jsr.io/schema/config-file.v1.json"
						},
						{
							"fileMatch": ["deno.json", "deno.jsonc"],
							"url": "https://cdn.jsdelivr.net/gh/denoland/deno@refs/heads/main/cli/schemas/config-file.v1.json"
						},
						{
							"fileMatch": ["package.json"],
							"url": "https://www.schemastore.org/package.json"
						},
						{
							"fileMatch": ["tsconfig.json", "tsconfig.*.json"],
							"url": "https://www.schemastore.org/tsconfig.json"
						},
						{
							"fileMatch": [
								".prettierrc",
								".prettierrc.json",
								".prettierrc.json5"
							],
							"url": "https://www.schemastore.org/prettierrc.json"
						},
						{
							"fileMatch": ["biome.json", "biome.jsonc", "biome.base.json"],
							"url": "https://biomejs.dev/schemas/latest/schema.json"
						},
						{
							"fileMatch": [
								"opencode.json",
								".opencode.json",
								"opencode.jsonc",
								".opencode.jsonc"
							],
							"url": "https://opencode.ai/config.json"
						},
						{
							"fileMatch": [
								"**/.claude/settings.json",
								"**/.claude/settings.local.json"
							],
							"url": "https://www.schemastore.org/claude-code-settings.json"
						},
						{
							"fileMatch": [
								"dprint.json",
								"dprint.jsonc",
								".dprint.json",
								".dprint.jsonc"
							],
							"url": "https://dprint.dev/schemas/v0.json"
						},
						{
							"fileMatch": [
								"lefthook.json",
								".lefthook.json",
								".config/lefthook.json"
							],
							"url": "https://raw.githubusercontent.com/evilmartians/lefthook/master/schema.json"
						},
						{
							"fileMatch": ["pnpm-workspace.yaml"],
							"url": "https://www.schemastore.org/pnpm-workspace.json"
						}
					]
				}
			}
		}
	},
	"file_types": {
		"Zig": ["zig", "zon"]
	}
}
