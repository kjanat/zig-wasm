# Auto-detect text files and perform LF normalization
* text=auto

# Source code - enforce LF
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Zig source files
*.zig text eol=lf
*.zon text eol=lf linguist-language=Zig

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Config files
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
Dockerfile text eol=lf

# Binary files - do not modify
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.xz binary
*.lzma binary

# Lock files - treat as generated
pnpm-lock.yaml -diff linguist-generated=true

# Better diffs for specific files
*.json diff=json
*.md diff=markdown

# Vendored/generated files - exclude from stats
**/dist/** linguist-generated=true
**/coverage/** linguist-generated=true
**/.zig-cache/** linguist-generated=true
**/zig-out/** linguist-generated=true
**/node_modules/** linguist-vendored=true

